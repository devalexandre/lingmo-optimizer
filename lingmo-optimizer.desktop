[Desktop Entry]
Type=Application
Name=Optimizer
Name[pt_BR]=Otimizador
Comment=Clean caches and free up disk space
Comment[pt_BR]=Limpe caches e libere espaço em disco
Exec=lingmo-optimizer
Icon=lingmo-optimizer
Terminal=false
Categories=System;
Keywords=clean;cache;optimize;disk;docker;npm;go;cargo;developer;
Keywords[pt_BR]=limpar;cache;otimizar;disco;docker;npm;go;cargo;desenvolvimento;
StartupNotify=true
X-Lingmo-Intents=optimizer.analyze;optimizer.clean.caches;
